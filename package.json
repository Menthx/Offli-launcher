{
  "name": "offli-launcher",
  "version": "0.2.0",
  "description": "Launcher hors ligne pour fangames et romhacks Pokémon",
  "main": "./out/main/index.js",
  "author": "Menthx",
  "homepage": "https://github.com/Menthx/Offli-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Menthx/Offli-launcher.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "rimraf": "file:./tools/shims/rimraf",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.8.9",
    "lodash.isequal": "file:./tools/shims/lodash.isequal",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "@electron/asar": "^4.3.1",
    "@electron/get": "^5.1.0",
    "temp": {
      "rimraf": "$rimraf"
    },
    "lodash.isequal": "$lodash.isequal"
  }
}
