{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/i18n.ts",
    "src/renderer/src/menuActions.ts",
    "src/renderer/src/minDuration.ts",
    "src/renderer/src/tour.ts",
    "src/renderer/src/hiddenGames.ts",
    "src/renderer/src/folders.ts",
    "src/renderer/src/updateUi.ts",
    "src/renderer/src/format.ts",
    "src/renderer/src/views/library/filters.ts",
    "tests/**/*"
  ]
}
